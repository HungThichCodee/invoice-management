{
  "name": "hoadon-xenang",
  "version": "1.0.0",
  "private": true,
  "description": "Quản lý hóa đơn và công nợ xe nâng ngoại tuyến",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "test": "node scripts/test.js",
    "postinstall": "electron-builder install-app-deps",
    "build": "electron-builder --dir",
    "dist": "electron-builder --win nsis portable",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "exceljs": "^4.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "lucide-static": "^1.56.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "build": {
    "appId": "vn.xenang.hoadon",
    "productName": "HoaDonXeNang",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "README.md"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "HoaDonXeNang_Setup.exe",
      "oneClick": false
    },
    "portable": {
      "artifactName": "HoaDonXeNang_Portable.exe"
    }
  }
}
