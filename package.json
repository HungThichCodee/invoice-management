{
  "name": "hoadon-xenang-offline",
  "version": "2.0.0",
  "private": true,
  "description": "Ứng dụng hóa đơn xe nâng offline cho Windows",
  "author": "Xe Nâng Minh Phát",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "electron .",
    "test": "node --test test/*.test.js",
    "check:lines": "node scripts/check-lines.js",
    "build": "electron-builder --win portable --x64",
    "dist": "npm run build"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.2.0",
    "@fontsource/material-symbols-outlined": "^5.3.0",
    "exceljs": "4.4.0"
  },
  "devDependencies": {
    "electron": "38.0.0",
    "electron-builder": "26.0.0"
  },
  "build": {
    "appId": "vn.xenang.hoadon.offline",
    "productName": "HoaDonXeNang",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "forklift.png",
      "package.json",
      "README.md"
    ],
    "win": {
      "target": "portable",
      "icon": "forklift.png"
    },
    "portable": {
      "artifactName": "HoaDonXeNang_Portable.exe"
    }
  }
}
